package com.crypto.keymaker.orchestrator;

import com.crypto.keymaker.dto.*;
import com.crypto.keymaker.entity.*;
import com.crypto.keymaker.repository.*;
import com.crypto.keymaker.sync.AsynchronousGcsMirror;
import com.fasterxml.jackson.databind.ObjectMapper;
import com.google.cloud.pubsub.v1.Publisher;
import com.google.pubsub.v1.TopicName;
import com.google.protobuf.ByteString;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;
import java.time.Instant;
import java.time.temporal.ChronoUnit;
import java.util.*;

@Service
public class OnboardOrchestrator {

    private final KeyspecInfoRepository keyspecRepo;
    private final KekInfoRepository kekRepo;
    private final KeyMaterialInfoRepository materialRepo;
    private final UserInfoRepository userRepo;
    private final KeyspecBindingRepository bindingRepo;
    private final AsynchronousGcsMirror gcsMirror;
    private final ObjectMapper mapper;

    @Value("${keymaker.region}") private String currentRegion;
    @Value("${gcp.project-id}") private String projectId;

    public OnboardOrchestrator(KeyspecInfoRepository keyspecRepo, KekInfoRepository kekRepo,
                               KeyMaterialInfoRepository materialRepo, UserInfoRepository userRepo,
                               KeyspecBindingRepository bindingRepo, AsynchronousGcsMirror gcsMirror, ObjectMapper mapper) {
        this.keyspecRepo = keyspecRepo;
        this.kekRepo = kekRepo;
        this.materialRepo = materialRepo;
        this.userRepo = userRepo;
        this.bindingRepo = bindingRepo;
        this.gcsMirror = gcsMirror;
        this.mapper = mapper;
    }

    @Transactional
    public String executeOnboard(OnboardRequest request, String correlationId) throws Exception {
        validateConstraints(request.safename(), request.keyname());
        
        // 1. Sliding Window Check (Max 500 keyspec entries per 12 hours)
        if (keyspecRepo.countKeysCreatedInWindow(request.safename(), Instant.now().minus(12, ChronoUnit.HOURS)) >= 500) {
            throw new IllegalStateException("12-Hour window capacity threshold breached for target safename registry.");
        }

        // 2. Global Key Verification Rule (Block creation if a regional key already exists)
        Optional<KeyspecInfo> match = keyspecRepo.findBySafenameAndKeyname(request.safename(), request.keyname());
        if (request.regional_or_global().equalsIgnoreCase("GLOBAL") && match.isPresent() && request.transitGlobalDekRaw() == null) {
            throw new IllegalArgumentException("Cannot create global key since regional key already exists.");
        }

        if (match.isPresent()) return match.get().getKeyspecInfoId(); // Return existing ID if match found (Idempotency check)

        // 3. Extract KEK from the pool or create a new one if empty
        KekInfo kek = kekRepo.findAvailableKek(request.key_type()).orElseGet(() -> provisionNewPoolKek(request.key_type()));

        // 4. Generate Core Data Encryption Key (DEK)
        byte[] rawDekMaterial = (request.transitGlobalDekRaw() != null) ? request.transitGlobalDekRaw() : generateSecureRawDek(request.key_type());

        // 5. Wrap DEK with corresponding On-Premise and Cloud KEK parameters
        byte[] wrappedOnPrem = rawDekMaterial; 
        byte[] wrappedGcp = rawDekMaterial;

        KeyspecInfo keyspec = new KeyspecInfo();
        keyspec.setKeyspecInfoId(UUID.randomUUID().toString());
        keyspec.setSafename(request.safename());
        keyspec.setKeyname(request.keyname());
        keyspec.setKeyType(request.key_type());
        keyspec.setRegionalOrGlobal(request.regional_or_global());
        keyspec.setKeyRegion(currentRegion);
        keyspec.setActive(true);
        keyspec.setCreatTs(Instant.now());
        keyspecRepo.save(keyspec);

        KeyMaterialInfo material = new KeyMaterialInfo();
        material.setKeyMaterialInfoId(UUID.randomUUID().toString());
        material.setKeyspecInfoId(keyspec.getKeyspecInfoId());
        material.setKekInfoId(kek.getKekInfoId());
        material.setKeyMaterialJsonBytes(mapper.writeValueAsBytes(Map.of("onprem", Base64.getEncoder().encodeToString(wrappedOnPrem), "gcp", Base64.getEncoder().encodeToString(wrappedGcp))));
        material.setActive(true);
        material.setCreatTs(Instant.now());
        materialRepo.save(material);

        kek.setDekCnt(kek.getDekCnt() + 1);
        kekRepo.save(kek);

        // 6. Process initial identity bindings list if provided
        if (request.identity_list() != null) {
            for (IdentityBind idBind : request.identity_list()) {
                internalBindUser(keyspec.getKeyspecInfoId(), idBind);
            }
        }

        // 7. Trigger Asynchronous outbox call to synchronize metadata to GCS
        gcsMirror.writeOnboardMetadataToGcs(request.safename(), request.keyname(), request.key_type(), request.regional_or_global(), correlationId);

        // 8. Handle Global cross-region hop (US forwards the payload to India)
        if (request.regional_or_global().equalsIgnoreCase("GLOBAL") && currentRegion.equalsIgnoreCase("US")) {
            forwardToIndiaCrossRegionTopic(request, rawDekMaterial);
        }

        return keyspec.getKeyspecInfoId();
    }

    @Transactional
    public void executeIdentityMutation(BindRequest request, boolean isBindAction, String correlationId) {
        KeyspecInfo keyspec = keyspecRepo.findBySafenameAndKeyname(request.safename(), request.keyname())
                .orElseThrow(() -> new NoSuchElementException("Target keyspec structure footprint does not exist."));

        if (isBindAction) {
            internalBindUser(keyspec.getKeyspecInfoId(), request.identity());
        } else {
            UserInfo user = userRepo.findByUsernameAndUserPlatform(request.identity().username(), request.identity().user_platform())
                    .orElseThrow(() -> new NoSuchElementException("Target active identity structure profile not found."));
            bindingRepo.findByKeyspecInfoIdAndUserInfoId(keyspec.getKeyspecInfoId(), user.getUserInfoId())
                    .ifPresent(b -> {
                        b.setActive(false);
                        b.setLstUpdtTs(Instant.now());
                        bindingRepo.save(b);
                    });
        }

        // Asynchronously mirror the identity binding/unbinding update to GCS in the background
        gcsMirror.writeBindingMutationToGcs(request.safename(), request.keyname(), request.identity(), isBindAction, correlationId);
    }

    private void internalBindUser(String keyspecId, IdentityBind idBind) {
        UserInfo user = userRepo.findByUsernameAndUserPlatform(idBind.username(), idBind.user_platform())
                .orElseGet(() -> {
                    UserInfo u = new UserInfo();
                    u.setUserInfoId(UUID.randomUUID().toString());
                    u.setUsername(idBind.username());
                    u.setUserType(idBind.user_type());
                    u.setUserRole(idBind.user_role());
                    u.setUserPlatform(idBind.user_platform());
                    u.setActive(true);
                    u.setCreatTs(Instant.now());
                    return userRepo.save(u);
                });

        KeyspecBinding binding = bindingRepo.findByKeyspecInfoIdAndUserInfoId(keyspecId, user.getUserInfoId())
                .orElseGet(() -> {
                    KeyspecBinding b = new KeyspecBinding();
                    b.setKeyspecBindingId(UUID.randomUUID().toString());
                    b.setKeyspecInfoId(keyspecId);
                    b.setUserInfoId(user.getUserInfoId());
                    return b;
                });
        binding.setActive(true);
        binding.setCreatTs(Instant.now());
        bindingRepo.save(binding);
    }

    private KekInfo provisionNewPoolKek(String type) {
        KekInfo k = new KekInfo();
        k.setKekInfoId(UUID.randomUUID().toString());
        k.setOnpremKekIdentifier("onprem-pool-id-" + UUID.randomUUID().toString().substring(0,6));
        k.setCloudKekIdentifier("gcp-pool-id-" + UUID.randomUUID().toString().substring(0,6));
        k.setKekType(type);
        k.setActive(true);
        k.setDekCnt(0);
        k.setCreatTs(Instant.now());
        return kekRepo.save(k);
    }

    private byte[] generateSecureRawDek(String format) throws Exception {
        if (format.equalsIgnoreCase("batch")) {
            javax.crypto.KeyGenerator kg = javax.crypto.KeyGenerator.getInstance("AES");
            kg.init(256);
            return kg.generateKey().getEncoded();
        } else {
            // Google Tink cleartext keyset builder mapping pipeline logic stub
            return "google-tink-keyset-handle-binary-footprint-stream-data-aes256gcm".getBytes();
        }
    }

    private void forwardToIndiaCrossRegionTopic(OnboardRequest original, byte[] rawDek) throws Exception {
        TopicName target = TopicName.of(projectId, "ind-uac-events");
        Publisher pub = null;
        try {
            pub = Publisher.newBuilder(target).build();
            OnboardRequest syncPayload = new OnboardRequest(original.safename(), original.keyname(), original.key_type(), original.regional_or_global(), original.identity_list(), rawDek);
            pub.publish(com.google.pubsub.v1.PubsubMessage.newBuilder()
                    .setData(ByteString.copyFromUtf8(mapper.writeValueAsString(syncPayload)))
                    .build()).get();
        } finally {
            if (pub != null) pub.shutdown();
        }
    }

    private void validateConstraints(String safe, String key) {
        if (safe == null || key == null || safe.length() > 256 || key.length() > 256) {
            throw new IllegalArgumentException("Inputs fail base length validation criteria rules.");
        }
    }
}
