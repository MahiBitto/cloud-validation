<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Standard Color-Coded Log Format Syntax Configuration -->
    <property name="CONSOLE_LOG_PATTERN" 
              value="%clr(%d{yyyy-MM-dd HH:mm:ss.SSS}){faint} %clr(${LOG_LEVEL_PATTERN:-%5p}) %clr(${PID:- }){magenta} %clr(---){faint} %clr([%15.15t]){faint} %clr(%-40.40logger{39}){cyan} %clr(:){faint} %m%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}"/>

    <!-- Include Spring Boot Default Console Pattern Utilities -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml" />

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>utf8</charset>
        </encoder>
    </appender>

    <!-- TRACE BOUNDARIES: Turn on maximum logging trace clarity for Keymaker internals -->
    <logger name="com.crypto.keymaker" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE" />
    </logger>

    <!-- SQL/EMULATOR BOUNDARIES: Trace every native Spanner SQL compilation statement happening locally -->
    <logger name="com.google.cloud.spring.data.spanner" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE" />
    </logger>
    <logger name="org.springframework.transaction" level="TRACE" additivity="false">
        <appender-ref ref="CONSOLE" />
    </logger>

    <!-- Global Application Catch-All Baseline Level -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
    </root>
</configuration>
